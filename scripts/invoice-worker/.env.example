# Example only. No hosted service is provisioned by this file.
PORT=8080
PETRAPLAN_KOSIT_JAR=/opt/kosit/validator.jar
PETRAPLAN_KOSIT_SCENARIOS=/opt/kosit/config/scenarios.xml
# Set a freshly generated server-side secret; use the same value in the API.
PETRAPLAN_INVOICE_WORKER_TOKEN=REPLACE_WITH_A_SERVER_SIDE_SECRET
# Enable only in the isolated invoice test environment, in API and worker.
PETRAPLAN_PDF_TEST_UPLOADS=1
