{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm install --prefix frontend/mobile-app",
  "buildCommand": "npm run build --prefix frontend/mobile-app",
  "outputDirectory": "frontend/mobile-app/dist",
  "rewrites": [
    {
      "source": "/cases/:path*",
      "destination": "/index.html"
    }
  ]
}
